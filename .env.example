# 复制为 .env.local，填写服务端配置后重启 npm run dev。
# 不配置也可使用排盘、运限、合盘起盘、古籍与百科。
# 密钥不得使用 NEXT_PUBLIC_ 前缀；不要提交 .env.local。

# OpenAI 兼容接口：openai-compatible / openai / deepseek
# Anthropic Messages 接口：anthropic
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=
# 填 API 根路径，程序追加 /chat/completions；anthropic 追加 /messages。
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=120000
# OpenAI 官方地址默认使用 max_completion_tokens，其他兼容服务默认 max_tokens。
# 若代理使用新 OpenAI 模型，可按其要求设置：
# AI_TOKEN_LIMIT_FIELD=max_completion_tokens

# 也兼容 OPENAI_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY；优先 AI_API_KEY。
# 当前为自用本地接口；公开部署前需配置用户身份验证与使用额度。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
